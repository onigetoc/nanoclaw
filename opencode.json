{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "agent": {
    "build": {
      "description": "Main development agent with full tool access",
      "mode": "primary",
      "temperature": 0.3,
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Intelligent task orchestrator that delegates to specialized subagents",
      "mode": "primary",
      "temperature": 0.2,
      "prompt": "{file:.opencode/prompts/orchestrator.txt}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
"task": {
          "planner": "allow",
          "researcher": "allow",
          "summarizer": "allow",
          "general": "allow",
          "explore": "allow",
          "task-planner": "allow",
          "task-executor": "allow"
        }
      }
    },
    "researcher": {
      "model": "small_model",
      "description": "Fast web research with small model"
    },
    "summarizer": {
      "model": "small_model",
      "description": "Quick synthesis with small model"
    },
    "planner": {
      "model": "model",
      "description": "Deep planning with full model"
    },
    "task-planner": {
      "model": "model",
      "description": "Creates task plans in groups/{group}/tasks/"
    },
    "task-executor": {
      "model": "model",
      "description": "Executes task plans from groups/{group}/tasks/"
    }
  },
  "mcp": {}
}
