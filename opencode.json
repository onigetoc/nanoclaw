{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.1-flash-lite-preview",
  "small_model": "opencode/big-pickle",
  "default_agent": "orchestrator",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "agent": {
    "build": {
      "description": "Main development agent with full tool access",
      "mode": "primary",
      "model": "google/gemini-3.1-flash-lite-preview",
      "temperature": 0.3,
      "prompt": "{file:.opencode/prompts/build.md}",
      "permission": {
        "skill": "allow",
        "task": {
          "*": "allow"
        }
      }
    },
    "orchestrator": {
      "description": "Intelligent task orchestrator that delegates to specialized subagents",
      "mode": "primary",
      "model": "google/gemini-3.1-flash-lite-preview",
      "temperature": 0.2,
      "prompt": "{file:.opencode/prompts/orchestrator.md}",
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "skill": "allow",
        "task": {
          "*": "allow"
        }
      }
    },
    "researcher": {
      "description": "Web research specialist — searches, fetches, compiles results with links"
    },
    "summarizer": {
      "description": "Synthesizes information from multiple sources into structured summaries"
    },
    "planner": {
      "description": "Decomposes complex tasks into executable subtask plans"
    },
    "task-planner": {
      "description": "Creates task plans in workspaces/{workspace}/tasks/"
    },
    "task-executor": {
      "description": "Executes task plans from workspaces/{workspace}/tasks/"
    },
    "talk": {
      "description": "Read-only agent - can ask, read files, and browse the internet but cannot execute commands or modify files",
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "edit": "deny",
        "bash": "deny",
        "write": "deny",
        "skill": "deny",
        "task": "deny"
      }
    }
  },
  "mcp": {}
}
