# EureClaw Configuration

# Assistant name (default: Andy)
ASSISTANT_NAME=Andy

# Set to true to use Telegram only (disable WhatsApp)
TELEGRAM_ONLY=true

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenCode SDK Configuration
# Optional: Custom OpenCode API endpoint (defaults to local instance)
# OPENCODE_BASE_URL=http://localhost:8080

# Optional: OpenCode server password (auto-set to 'eureclaw-local-dev' if not specified)
# Only needed if you want to secure the local OpenCode server or use a custom password
# OPENCODE_SERVER_PASSWORD=your-secure-password

# Logging Configuration
# Options: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# === AI Provider API Keys (OpenCode Configuration) ===

# IMPORTANT: OpenCode manages AI provider API keys through its own authentication system.
# You have 3 options to configure API keys:
#
# Option 1 (Recommended): Use OpenCode's auth system
#   Run: opencode auth login
#   Select your provider (Google, Anthropic, OpenAI, etc.)
#   Paste your API key when prompted
#   Keys are stored securely in: ~/.local/share/opencode/auth.json
#
# Option 2: System environment variables (cross-session)
#   Windows: Add to System Environment Variables via Control Panel
#   Mac/Linux: Add to ~/.zshrc or ~/.bashrc:
#     export GOOGLE_API_KEY="your_key_here"
#     export ANTHROPIC_API_KEY="your_key_here"
#
# Option 3: Session environment variables (temporary)
#   Windows PowerShell: $env:GOOGLE_API_KEY="your_key_here"
#   Mac/Linux: export GOOGLE_API_KEY="your_key_here"
#
# Note: Keys in this .env file are NOT automatically used by OpenCode.
# If you want to use .env, you must manually export them to system environment.
#
# Uncomment and add your keys here for reference, but remember to export them:
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === Audio Transcription Configuration ===

# Enable audio transcription (default: true)
AUDIO_ENABLED=true

# Audio provider: groq (free), openai (paid), local (whisper-cpp), whisper Ollama
AUDIO_PROVIDER=groq

# Strip raw audio binary after successful transcription (default: true)
# This prevents token waste from binary data in context
AUDIO_STRIP_AFTER_TRANSCRIPT=true

# Transcription timeout in milliseconds (default: 30000 = 30s)
AUDIO_TIMEOUT=30000

# Max audio file size in bytes (default: 26214400 = 25MB, Whisper limit)
AUDIO_MAX_FILE_SIZE=26214400

# Groq Whisper API (FREE - Recommended)
# Get your API key from: https://console.groq.com
# Free tier: 2000 requests/day, 8 hours audio/day
GROQ_API_KEY=

# Groq Whisper model: whisper-large-v3 or whisper-large-v3-turbo (faster)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI Whisper API (Fallback - Paid)
# Only needed if you want to use OpenAI instead of Groq
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
