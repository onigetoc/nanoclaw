# NanoClaw Configuration

# Assistant name (default: Andy)
ASSISTANT_NAME=Andy

# Set to true to use Telegram only (disable WhatsApp)
TELEGRAM_ONLY=true

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenCode SDK Configuration
# Optional: Custom OpenCode API endpoint (defaults to local instance)
# OPENCODE_BASE_URL=http://localhost:8080

# Logging Configuration
# Options: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Note: OpenCode SDK reads AI provider API keys from system configuration
# Configure providers using: opencode auth login
# No need to set ANTHROPIC_API_KEY, GOOGLE_API_KEY, etc. in this file
