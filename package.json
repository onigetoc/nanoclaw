{
  "name": "eureclaw",
  "version": "1.0.0",
  "description": "Personal Opencode assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bun scripts/run-with-restart.js",
    "start:simple": "bun scripts/start-with-opencode.js",
    "dev": "bun scripts/start-with-opencode.js",
    "dev:simple": "bun scripts/auto-setup.js && bun --watch src/index.ts",
    "auth": "bun --watch src/whatsapp-auth.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:context": "bun scripts/generate-context-files.js",
    "setup": "bun scripts/auto-setup.js",
    "monitor": "bun src/monitoring-cli.ts",
    "monitor:stats": "bun src/monitoring-cli.ts --stats",
    "monitor:logs": "bun src/monitoring-cli.ts --logs",
    "kill": "npx kill-port 5173 5174 5175"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@opencode-ai/sdk": "^1.2.24",
    "@types/js-yaml": "^4.0.9",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "cron-parser": "^5.5.0",
    "fastify": "^5.7.4",
    "grammy": "^1.40.0",
    "js-yaml": "^4.1.1",
    "openai": "^6.22.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/fastify-cors": "^0.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
